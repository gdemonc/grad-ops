[Unit]
Description=Grad-Ops evidence-constrained operations control plane
Documentation=file:/usr/share/doc/gradops/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gradops
Group=gradops
UMask=0077
WorkingDirectory=/var/lib/gradops
StateDirectory=gradops
EnvironmentFile=-/etc/gradops/gradops.env
ExecStart=/usr/local/bin/gradops
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillMode=control-group

# Service-level containment. The app still applies prlimit and an optional
# run-as identity to each shell; this unit keeps the whole process inside a
# non-root account and a reduced filesystem view.
NoNewPrivileges=yes
# bubblewrap needs these capabilities inside its private user namespace to
# mount the read-only root, /proc, /dev and /tmp. They are not ambient and the
# service still has no effective capabilities in the host namespace.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_CHROOT CAP_SETUID CAP_SETGID CAP_MKNOD CAP_DAC_OVERRIDE
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=full
ProtectHome=yes
# A fresh procfs mount inside bubblewrap's user namespace is refused when the
# existing /proc has systemd's over-mounts. Keep the protections that do not
# over-mount /proc; the per-action sandbox supplies its own procfs.
ProtectKernelTunables=no
ProtectKernelModules=no
ProtectKernelLogs=no
# The service creates a child cgroup per shell. systemd must delegate the
# subtree, and the cgroup hierarchy must be writable for that delegation.
Delegate=yes
DelegateSubgroup=supervisor
ProtectControlGroups=no
ProtectClock=no
ProtectHostname=no
RestrictNamespaces=no
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes

# Resource ceilings for the whole service. Per-shell limits remain in
# GRADOPS_RLIMIT_*; these stop one runaway service from taking the host.
MemoryMax=1G
TasksMax=256
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target

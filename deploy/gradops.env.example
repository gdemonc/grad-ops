# EnvironmentFile for gradops.service. Install at /etc/gradops/gradops.env
# with mode 0600 and owner root:gradops.
#
# The unit runs as the non-root "gradops" user with NoNewPrivileges=yes, so
# GRADOPS_EXECUTOR_USER can only be empty or "gradops". Leave it empty unless
# the deployment has a separate runtime that can switch identity.

GRADOPS_ADDR=127.0.0.1:8080
GRADOPS_DB_PATH=/var/lib/gradops/gradops.db
GRADOPS_LOG_LEVEL=info
GRADOPS_MAX_REQUEST_BYTES=1048576

GRADOPS_BASH=/bin/bash
GRADOPS_WORK_DIR=/
GRADOPS_CONTRACT_WORK_DIR=/
GRADOPS_ALLOWED_ROOTS=/var/log
# Separate trusted roots for fd-based file operations; empty disables file actions.
GRADOPS_FILE_ROOTS=
GRADOPS_POLICY_VERSION=2026-11-01
GRADOPS_APPROVAL_TTL=15m
GRADOPS_PROBE_TIMEOUT=10s
GRADOPS_INVESTIGATION_TIMEOUT=5m
GRADOPS_EXECUTION_TIMEOUT=5m
GRADOPS_MAX_OUTPUT_BYTES=65536
GRADOPS_WORKER=true
GRADOPS_PROBE_CONSOLE=false

# Per-shell cgroup v2 boundary. Requires the unit's Delegate=yes delegation;
# startup fails closed if the delegated subtree is not writable.
GRADOPS_RUNTIME=cgroup-v2
GRADOPS_CGROUP_MEMORY_MAX_BYTES=536870912
GRADOPS_CGROUP_PIDS_MAX=256
GRADOPS_CGROUP_CPU_QUOTA_MICROS=0
GRADOPS_CGROUP_CPU_PERIOD_MICROS=100000

# Per-shell bubblewrap sandbox: private mount/PID/IPC/UTS/user namespaces,
# read-only root and an isolated network namespace. Writable roots come from
# GRADOPS_ALLOWED_ROOTS. Set to "none" only if bubblewrap cannot run here.
GRADOPS_SANDBOX=bubblewrap
GRADOPS_BWRAP=/usr/bin/bwrap
GRADOPS_SANDBOX_NETWORK=false

GRADOPS_PRLIMIT=/usr/bin/prlimit
GRADOPS_RLIMIT_CPU=10s
GRADOPS_RLIMIT_AS_BYTES=536870912
GRADOPS_RLIMIT_NPROC=256
GRADOPS_RLIMIT_FSIZE_BYTES=16777216
GRADOPS_RLIMIT_NOFILE=256

GRADOPS_PLANNER=stub
# openai or deepseek; deepseek fills the compatible base URL and model defaults.
GRADOPS_LLM_PROVIDER=openai
# Multi-round observe/finish loop; requires GRADOPS_PLANNER=model.
GRADOPS_AGENT_LOOP=false
GRADOPS_AGENT_MAX_ROUNDS=20
GRADOPS_AGENT_MAX_CALLS=40
GRADOPS_AGENT_MAX_CALLS_PER_ROUND=5
GRADOPS_AGENT_CONTEXT_BYTES=32768
GRADOPS_LLM_BASE_URL=
GRADOPS_LLM_API_KEY=
GRADOPS_LLM_MODEL=
GRADOPS_LLM_TIMEOUT=30s
GRADOPS_LLM_MAX_RESPONSE_BYTES=1048576
GRADOPS_LLM_MAX_PROBES=6
GRADOPS_LLM_MAX_OBSERVATION_BYTES=4096
GRADOPS_LLM_MAX_TOKENS=1024

# Required when GRADOPS_ADDR is not loopback. Use at least 16 characters.
# Store the same value in the console's localStorage key gradops_api_token.
GRADOPS_API_TOKEN=

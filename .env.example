# Grad-Ops Go service configuration.
#
# The service reads the process environment; it does not parse this file
# itself. Use it as an EnvironmentFile for systemd or source it in a shell.
# Every value is validated at startup and invalid configuration fails closed.

GRADOPS_ADDR=127.0.0.1:8080
# /api bearer token. Empty is allowed only while the listener is loopback.
# Use at least 16 characters when binding to a non-loopback address.
GRADOPS_API_TOKEN=
GRADOPS_DB_PATH=./data/gradops.db
GRADOPS_LOG_LEVEL=info
GRADOPS_MAX_REQUEST_BYTES=1048576

GRADOPS_BASH=/bin/bash
GRADOPS_WORK_DIR=/
GRADOPS_CONTRACT_WORK_DIR=/
GRADOPS_ALLOWED_ROOTS=/var/log
GRADOPS_POLICY_VERSION=2026-11-01
GRADOPS_APPROVAL_TTL=15m
GRADOPS_PROBE_TIMEOUT=10s
GRADOPS_INVESTIGATION_TIMEOUT=5m
GRADOPS_EXECUTION_TIMEOUT=5m
GRADOPS_MAX_OUTPUT_BYTES=65536
GRADOPS_WORKER=true
GRADOPS_PROBE_CONSOLE=false

# Execution identity. Empty means "use the service process identity".
# When set, the shell switches to this account; a non-root service that cannot
# switch fails at startup rather than running as somebody else.
GRADOPS_EXECUTOR_USER=
GRADOPS_REQUIRE_RUN_AS_MATCH=false

# Linux resource limits applied with util-linux prlimit. Set an individual
# value to 0 to leave that limit unlimited.
GRADOPS_RUNTIME=direct
GRADOPS_SANDBOX=none
GRADOPS_BWRAP=/usr/bin/bwrap
GRADOPS_SANDBOX_NETWORK=false
GRADOPS_CGROUP_ROOT=
GRADOPS_CGROUP_MEMORY_MAX_BYTES=536870912
GRADOPS_CGROUP_PIDS_MAX=256
GRADOPS_CGROUP_CPU_QUOTA_MICROS=0
GRADOPS_CGROUP_CPU_PERIOD_MICROS=100000

GRADOPS_PRLIMIT=/usr/bin/prlimit
GRADOPS_RLIMIT_CPU=10s
GRADOPS_RLIMIT_AS_BYTES=536870912
GRADOPS_RLIMIT_NPROC=256
GRADOPS_RLIMIT_FSIZE_BYTES=16777216
GRADOPS_RLIMIT_NOFILE=256

# Investigation planner. "stub" runs fixed read-only probes; "model" calls an
# OpenAI-compatible provider. The model never authorizes or executes anything:
# probes pass the read-only analyzer, actions pass policy and approval.
GRADOPS_PLANNER=stub
# Multi-round observe/finish loop; requires GRADOPS_PLANNER=model.
GRADOPS_AGENT_LOOP=false
GRADOPS_AGENT_MAX_ROUNDS=6
GRADOPS_AGENT_MAX_CALLS_PER_ROUND=3
GRADOPS_AGENT_CONTEXT_BYTES=32768
GRADOPS_LLM_BASE_URL=
GRADOPS_LLM_API_KEY=
GRADOPS_LLM_MODEL=
GRADOPS_LLM_TIMEOUT=30s
GRADOPS_LLM_MAX_RESPONSE_BYTES=1048576
GRADOPS_LLM_MAX_PROBES=6
GRADOPS_LLM_MAX_OBSERVATION_BYTES=4096
GRADOPS_LLM_MAX_TOKENS=1024
